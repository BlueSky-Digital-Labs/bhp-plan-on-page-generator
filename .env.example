# Reference for the variables the backend reads (export them or pass inline; nothing loads this file
# automatically). No real credentials here.
# Everything below is read by the FastAPI backend only. The frontend reads NO environment
# variables: Vite-exposed (VITE_*) values are baked into public browser assets.

# Required. One of: local | test | deployed
APP_ENV=local

# Optional
AWS_REGION=ap-southeast-2
LOG_LEVEL=INFO

# Secrets (optional until the features that use them land). In AWS these come from
# Secrets Manager via the task role, never from the image or a committed file.
# ACCESS_CODE_HASH=
# COOKIE_SIGNING_KEY=
